# Ollama OpenAI-compatible endpoint on the GPU server.
# Must include the trailing /v1 path.
OLLAMA_BASE_URL=http://192.168.x.x:11434/v1
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.1:8b

# Secret used to seal the session cookie. MUST be >= 32 characters.
# Change this before any non-local use.
SESSION_SECRET=change-me-in-production-min-32-characters
